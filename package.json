{
  "name": "avex-pay-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "AVEX Pay \u2014 non-custodial crypto payment gateway with Telegram Stars",
  "workspaces": [
    "packages/*",
    "apps/*",
    "contracts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b apps/api",
    "typecheck": "tsc -b apps/api --dry",
    "test": "npm run test --workspaces --if-present && npm run test:plugin",
    "test:plugin": "php integrations/woocommerce/tests/run-tests.php",
    "plugin:zip": "node integrations/woocommerce/build-zip.mjs",
    "plugin:assets": "node integrations/woocommerce/assets/render-assets.mjs",
    "build:static": "npm run build --workspaces --if-present && node deploy/build-static.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
