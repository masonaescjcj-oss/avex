{
  "name": "@avex/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --dry",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "watch": "node dist/watcher.js",
    "preflight": "node dist/preflight.js"
  },
  "dependencies": {
    "@avex/core": "*",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1"
  }
}
