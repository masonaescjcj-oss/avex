# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://avex:avex@localhost:5432/avex

SESSION_TTL_HOURS=336
EMAIL_TOKEN_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=120

# Pricing. Which sources are enabled is configuration, not code: a source that is
# unreachable from where this runs would fail every request and hold the circuit
# breaker open, blocking invoices for a reason unrelated to the market.
# Known sources: coingecko, binance, kraken
PRICE_SOURCES=coingecko,binance,kraken
PRICE_MIN_SOURCES=2
PRICE_OUTLIER_TOLERANCE_BPS=200
PRICE_MAX_DISPERSION_BPS=300
PRICE_MAX_STALENESS_MS=120000
PRICE_CACHE_TTL_MS=10000

# EVM RPC endpoints for contract vetting and settlement, as chain=url pairs.
# Several per chain is intended: hosted providers geofence some regions, and a
# single endpoint makes vetting depend on one vendor being reachable.
EVM_RPC_URLS=bsc=https://bsc-dataseed.binance.org,bsc=https://bsc-dataseed1.defibit.io

# ─────────────────────────────────────────────────────────────────────────────
# Everything below was missing from this file while it existed only for local
# development. It is here because a variable nobody documented is a variable
# nobody sets, and most of the ones on this list fail by staying quiet.
#
# For a real deployment read docs/GO-LIVE-fa.md, which puts these in the order
# they have to be set and says what each one breaks when it is absent.
# ─────────────────────────────────────────────────────────────────────────────

# The second connection string, which must always reach Postgres directly.
# Migrations create enum types and CREATE TYPE through a transaction pooler
# fails in a way that reads like a syntax error in the migration. On Supabase
# this is the URI on port 5432, not the pooler on 6543. Falls back to
# DATABASE_URL, which is right for a plain Postgres.
# DIRECT_DATABASE_URL=postgres://…:5432/postgres
# DATABASE_PREPARE=false

# Where the *static pages* are, not the API: verification links point at
# APP_URL/dashboard and payer links at APP_URL/pay/<id>. Pointing this at the
# API host produces mail whose links 404.
APP_URL=http://localhost:3000

# Transactional mail. Unset means every message is composed, logged and never
# sent — so signup completes and no merchant can confirm an address.
# SMTP_URL=smtps://user:password@smtp.example.net:465
MAIL_FROM=no-reply@avexpay.net
MAIL_FROM_NAME=AVEX Pay

# Where a critical alert goes: a dry gas wallet, a stuck nonce, a reverted
# settlement, a watcher whose cursor stopped moving. Unset means logged only.
# Once per kind per fifteen minutes.
# OPERATOR_EMAIL=ops@avexpay.net

# Browser origins allowed to call the API. Empty means no cross-origin access
# at all, which is right when the pages are served from the API's own origin.
# CHECKOUT_ORIGINS is the payer's checkout; DASHBOARD_ORIGINS carries
# credentials, so it is named origins only and never a wildcard.
# CHECKOUT_ORIGINS=https://avexpay.net
# DASHBOARD_ORIGINS=https://avexpay.net

# The background jobs: webhook retries, commission periods, and the
# twenty-four-hour delays on payout and deposit-wallet changes. In-process
# timers by default, which is right for a long-running server. Turn them off
# and set CRON_SECRET only where an external scheduler drives
# POST /internal/jobs instead — with neither, that route answers 404 and no
# webhook is ever retried.
# RUN_JOBS_IN_PROCESS=true
# CRON_SECRET=

# Deployed contracts, per chain. Both halves or neither: a deposit address is a
# hash over the factory *and* the logic address, so a mismatched pair derives
# addresses that factory can never settle. contracts/deploy.mjs prints these
# two lines and refuses to print them if its own prediction disagrees.
# FORWARDER_FACTORIES=bsc=0x…
# FORWARDER_IMPLEMENTATIONS=bsc=0x…

# Where commission is collected, per chain. A chain missing from here charges
# no commission at all rather than sending a fee to an address on another chain
# that cannot receive it.
# FEE_COLLECTORS=bsc=0x…

# The settlement signer. LocalKeyProvider refuses to hold this in process
# memory when NODE_ENV=production, and that refusal is correct — the key can
# move every merchant's funds. Production needs a KMS-backed KeyProvider.
# SETTLEMENT_KEY_HEX=0x…
# SETTLEMENT_PRIORITY_FRACTION=0.1

# Shared-address chains (TON): one wallet per chain. The memo secret is what
# makes an invoice memo unguessable — a memo is visible to anyone watching the
# shared wallet, and a predictable one lets a stranger claim someone else's
# payment. The default below is for development and must be replaced.
# SHARED_DEPOSIT_WALLETS=ton=UQ…
# MEMO_SECRET=
