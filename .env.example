# Copy to .env for local development. Never commit a real .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

DATABASE_URL=postgres://avex:avex@localhost:5432/avex
APP_URL=http://localhost:3000

SESSION_TTL_HOURS=336
EMAIL_TOKEN_TTL_MINUTES=60
RATE_LIMIT_PER_MINUTE=120

# Pricing. Which sources are enabled is configuration, not code: a source that is
# unreachable from where this runs would fail every request and hold the circuit
# breaker open, blocking invoices for a reason unrelated to the market.
# Known sources: coingecko, binance, kraken
PRICE_SOURCES=coingecko,binance,kraken
PRICE_MIN_SOURCES=2
PRICE_OUTLIER_TOLERANCE_BPS=200
PRICE_MAX_DISPERSION_BPS=300
PRICE_MAX_STALENESS_MS=120000
PRICE_CACHE_TTL_MS=10000

# EVM RPC endpoints for contract vetting and settlement, as chain=url pairs.
# Several per chain is intended: hosted providers geofence some regions, and a
# single endpoint makes vetting depend on one vendor being reachable.
EVM_RPC_URLS=bsc=https://bsc-dataseed.binance.org,bsc=https://bsc-dataseed1.defibit.io
