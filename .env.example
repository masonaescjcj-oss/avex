# Contact form delivery. Configure at least one channel; without either, the
# form falls back to opening Telegram or the visitor's mail client.

# --- Telegram (recommended) -------------------------------------------------
# 1. Message @BotFather on Telegram, send /newbot, copy the token it returns.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id
#    (for a channel, add the bot as admin and use the channel id, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email via Resend (optional) --------------------------------------------
# resend.com — free tier covers 3,000 emails/month. The from address must be on
# a domain you have verified with Resend.
RESEND_API_KEY=
CONTACT_EMAIL_TO=info@retroai.agency
CONTACT_EMAIL_FROM=RetroAI <site@retroai.agency>
